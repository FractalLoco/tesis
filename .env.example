# Copiar a .env y completar (el .env real no se sube al repositorio).

# Credenciales por defecto de SOLO LECTURA hacia la base objetivo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=optimizacion
DB_USER=analizador_ro
DB_PASSWORD=
# Segundos máximos de espera al conectar con PostgreSQL
DB_CONNECT_TIMEOUT=10

# Orígenes permitidos por CORS, separados por coma (desarrollo + despliegue)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://tu-dominio.cl

# Puerto en que iniciar.py levanta el servidor
PUERTO=8000

# true = la pantalla de conexión llega llena con la base de arriba y la contraseña
# puede dejarse en blanco (se usa DB_PASSWORD). Útil en local; en un servidor
# público dejar en false.
PRECARGAR_CONEXION=false

# V3 (índices y plan juntos): PostgreSQL PROPIO de la aplicación, con HypoPG
# instalado y un usuario que pueda crear bases. Ahí se arma la "base gemela" con
# las estadísticas del servidor del usuario; en ese servidor solo se lee.
# Ejemplo: GEMELA_DSN=host=localhost port=5432 dbname=postgres user=gemela password=...
# Vacío = la V3 aparece como no disponible.
GEMELA_DSN=
