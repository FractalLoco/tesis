# Copiar a .env y completar (el .env real no se sube al repositorio).

# Base por defecto, con un usuario de SOLO LECTURA
DB_HOST=localhost
DB_PORT=5432
DB_NAME=optimizacion
DB_USER=analizador_ro
DB_PASSWORD=

# Límites de tiempo: al conectar (segundos) y por consulta, bloqueo y transacción inactiva (ms)
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=60000

# true = la pantalla de conexión llega llena con la base de arriba y la clave se puede
# dejar en blanco (nunca viaja al navegador). Solo para uso local.
PRECARGAR_CONEXION=false

# false = los errores no muestran el detalle de PostgreSQL (hosts, versiones). Usar false en un servidor.
MOSTRAR_DETALLE_TECNICO=true

# Dónde escucha iniciar.py: 127.0.0.1 = solo este equipo; 0.0.0.0 = la red (la API no tiene login)
BIND_HOST=127.0.0.1
PUERTO=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# V3: PostgreSQL propio de la app, con HypoPG y un usuario que pueda crear bases.
# Ejemplo: GEMELA_DSN=host=localhost port=5432 dbname=postgres user=gemela password=...
# Vacío = la V3 aparece como no disponible.
GEMELA_DSN=

# --- Solo para Docker (docker compose) ---
# En un servidor cambia estas claves antes del primer "docker compose up"
DOCKER_CLAVE_POSTGRES=
DOCKER_CLAVE_SOLO_LECTURA=
DOCKER_PUERTO=8020
# 127.0.0.1 = la página solo se abre en este equipo; 0.0.0.0 = también desde la red o un servidor
DOCKER_IP=127.0.0.1
# false en un servidor: así nadie entra a la base sin escribir la clave
DOCKER_PRECARGAR=true
# Dirección con la que se abre la página, ej: http://IP_DEL_SERVIDOR:8020
DOCKER_CORS=
